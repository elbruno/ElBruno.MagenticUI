@page "/local-models"
@rendermode InteractiveServer
@using ElBruno.LocalLLMs
@inject ModelStateService ModelState

<PageTitle>Local models · MagenticUI</PageTitle>

<div class="container-fluid py-4 local-models-page">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
        <div>
            <h1 class="h3 mb-1">Local models</h1>
            <p class="text-muted mb-0">Manage the local ONNX models used by MagenticUI — download, delete, and inspect where they're cached.</p>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h2 class="h5">Environment</h2>
            <p class="text-muted small">
                Hardware, runtime, and execution-provider readiness reported by
                <code>ElBruno.LocalLLMs</code>, including which providers passed preflight and why
                any of them are unavailable.
            </p>
            <EnvironmentDashboard ShowCacheInfo="true" ShowOpenFolderButton="true" />
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h2 class="h5 mb-2">Local models</h2>
            <p class="text-muted small">
                MagenticUI uses <code>Phi-3.5-mini-instruct</code> for text orchestration and
                <code>Fara1.5-9B</code> for screenshot visual grounding. Models auto-download from
                Hugging Face on first use unless a local <code>ModelPath</code> is configured in
                <code>appsettings.json</code>. <code>MagenticBrain</code> (Qwen3-14B agentic fine-tune) is
                also listed below as an optional pre-download — it's not wired into the orchestrator yet,
                but you can fetch it here ahead of time if you plan to switch to it.
            </p>
            <p class="text-muted small mb-2">
                Cache directory: <code>@ModelState.CacheDirectory</code>
                (use <strong>Open folder</strong> in the Environment panel above to browse it).
            </p>
            <p class="text-muted small mb-3">
                ℹ️ Large downloads (Fara1.5-9B is ~10&nbsp;GB, MagenticBrain is several GB) run on the server
                and continue in the background — closing this tab, refreshing, or a dropped connection will
                <strong>not</strong> cancel them. Reopen this page at any time to see live progress, or use
                <strong>Cancel</strong> to stop a download explicitly. Completed files are always kept, so a
                download interrupted by an error is safe to restart.
            </p>
            <ModelGallery Models="ManagedModels" />
        </div>
    </div>
</div>

@code {
    private static readonly IReadOnlyList<ModelDefinition> ManagedModels =
    [
        KnownModels.Phi35MiniInstruct,
        KnownModels.Fara15_9B,
        KnownModels.MagenticBrain
    ];
}
