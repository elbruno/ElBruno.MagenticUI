@page "/"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject AgentSessionService Session
@inject IModelStatusService ModelStatus
@inject IModelDownloadProgressStateService ModelDownloadProgressState
@inject IConfiguration Config
@inject IJSRuntime JS
@using ElBruno.MagenticUI.App.ModelDownloadProgress
@using ElBruno.MagenticUI.App.ModelSettings

<PageTitle>MagenticUI — Local Multi-Agent AI</PageTitle>

<div class="container-fluid py-3 magentic-root">
    <div class="row mb-3 align-items-center">
        <div class="col">
            <h2 class="mb-0 fw-bold">🧠 MagenticUI</h2>
            <small class="text-muted">Local multi-agent AI · powered by ONNX via ElBruno.LocalLLMs</small>
        </div>
        <div class="col-auto">
            <span class="badge fs-6 @StatusBadgeClass">@StatusText</span>
        </div>
    </div>
    @if (IsAutoDownloadMode)
    {
        <details class="mb-3 collapsible-panel">
            <summary class="collapsible-summary">
                ⚙️ Auto-download model info
            </summary>
            <div class="alert alert-info d-flex align-items-start gap-2 mb-0">
                <span>⚙️</span>
                <div>
                    <strong>Auto-download mode enabled.</strong>
                    No explicit model paths are set, so the app will download
                    <code>@OrchestratorModelName</code> (orchestrator) and <code>@ComputerModelName</code> (computer-use)
                    on first task runs.<br />
                    For local ONNX folders, configure:
                    <code>LocalLLMs:Models:Orchestrator:ModelPath</code> and
                    <code>LocalLLMs:Models:ComputerUse:ModelPath</code>.
                </div>
            </div>
        </details>
    }
    @if (Session.Status is AgentTaskStatus.Error && Session.LastError is not null)
    {
        <div class="alert alert-danger">
            <strong>⚠️ Error:</strong> @Session.LastError
        </div>
    }
    <details class="mb-3 collapsible-panel">
        <summary class="collapsible-summary">
            📦 Model download status (@DisplayModelStatuses.Count models)
        </summary>
        <div class="card shadow-sm model-download-card mb-0">
            <div class="card-body py-2 px-3">
                @foreach (var modelStatus in DisplayModelStatuses)
                {
                    var download = modelStatus.DownloadState;
                    var percent = modelStatus.DisplayPercent;
                    <div class="model-download-row">
                        <div class="d-flex justify-content-between align-items-center gap-2">
                            <div class="model-download-title">
                                <span class="badge text-bg-light border">@GetRoleLabel(modelStatus.Entry.Role)</span>
                                <strong class="ms-2">@GetModelLabel(modelStatus)</strong>
                                <span class="badge ms-2 @GetDownloadPhaseBadgeClass(modelStatus.EffectivePhase)">
                                    @GetDownloadPhaseText(modelStatus.EffectivePhase)
                                </span>
                            </div>
                            <span class="model-download-percent">@percent.ToString("0.##")%</span>
                        </div>
                        <div class="progress model-download-progress" role="progressbar" aria-valuenow="@percent" aria-valuemin="0" aria-valuemax="100">
                            <div class="progress-bar @(modelStatus.EffectivePhase == ModelDownloadPhase.Downloading ? "progress-bar-striped progress-bar-animated" : string.Empty)"
                                 style="width: @($"{percent:0.##}%")"></div>
                        </div>
                        <div class="model-download-meta text-muted">
                            <span>@modelStatus.StatusText</span>
                            @if (download.TotalBytes > 0)
                            {
                                <span>· @FormatBytes(download.DownloadedBytes) / @FormatBytes(download.TotalBytes)</span>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </details>
    @if (RecentDownloadNotices.Count > 0)
    {
        <div class="model-download-notices mb-2">
            @foreach (var notice in RecentDownloadNotices)
            {
                <div class="small @(notice.DownloadState.Phase == ModelDownloadPhase.Failed ? "text-danger" : "text-success")">
                    @(notice.DownloadState.Phase == ModelDownloadPhase.Failed ? "⚠" : "✓")
                    @GetRoleLabel(notice.Entry.Role) model @GetModelLabel(notice)
                    @(notice.DownloadState.Phase == ModelDownloadPhase.Failed ? $" failed: {notice.DownloadState.Error ?? notice.StatusText}" : " is ready.")
                </div>
            }
        </div>
    }
    @if (Session.Status is AgentTaskStatus.Idle or AgentTaskStatus.Done or AgentTaskStatus.Error)
    {
        <div class="card mb-3 shadow-sm">
            <div class="card-body">
                <h5 class="card-title mb-3">New Task</h5>
                <textarea class="form-control mb-2 task-input"
                          rows="4"
                          @bind="taskInput"
                          @bind:event="oninput"
                          placeholder="@TaskPlaceholder"
                          @onkeydown="HandleTaskKeyDown"></textarea>
                <div class="d-flex gap-2 align-items-center">
                    <button class="btn btn-primary" @onclick="StartTask"
                            disabled="@(string.IsNullOrWhiteSpace(taskInput))">
                        ▶ Start Task
                    </button>
                    <small class="text-muted">Ctrl+Enter to submit</small>
                </div>
                <div class="quick-actions mt-3">
                    <small class="text-muted d-block mb-2">Quick scenarios</small>
                    @foreach (var scenario in QuickScenarios)
                    {
                        <div class="quick-action-item">
                            <div class="quick-action-title">@scenario.Title</div>
                            <div class="quick-action-buttons">
                                <button class="btn btn-outline-primary btn-sm" @onclick="() => UseQuickScenario(scenario.Prompt)">
                                    Use prompt
                                </button>
                                <button class="btn btn-outline-success btn-sm" @onclick="() => CopyQuickScenarioPrompt(scenario)">
                                    @(copiedScenarioTitle == scenario.Title ? "Copied ✓" : "Copy prompt")
                                </button>
                                <a class="btn btn-outline-secondary btn-sm"
                                   href="@scenario.TutorialUrl"
                                   target="_blank"
                                   rel="noopener noreferrer">
                                    Tutorial
                                </a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(currentTaskPrompt))
    {
        <div class="card mb-3 shadow-sm">
            <div class="card-header fw-semibold">Current task</div>
            <div class="card-body py-2">
                <div class="small text-muted mb-1">Started: @currentTaskStartedAt?.LocalDateTime.ToString("HH:mm:ss") · Status: @StatusText</div>
                <pre class="message-body mb-0">@currentTaskPrompt</pre>
            </div>
        </div>
    }
    @if (Session.Status is AgentTaskStatus.Running or AgentTaskStatus.WaitingForInput)
    {
        <div class="mb-3">
            <button class="btn btn-outline-danger btn-sm" @onclick="CancelTaskFromUi">
                ✕ Cancel Task
            </button>
        </div>
    }
    @if (Session.Status == AgentTaskStatus.WaitingForInput && Session.PendingQuestion is not null)
    {
        <div class="card border-warning mb-3 shadow-sm input-request-card">
            <div class="card-header bg-warning bg-opacity-25 fw-bold">
                👤 Agent needs your input
            </div>
            <div class="card-body">
                <p class="mb-3 fw-semibold">@Session.PendingQuestion</p>
                <textarea class="form-control mb-2"
                          rows="3"
                          @bind="userResponse"
                          @bind:event="oninput"
                          placeholder="Type your response…"
                          @onkeydown="HandleResponseKeyDown"
                          autofocus></textarea>
                <button class="btn btn-warning" @onclick="SendResponse"
                        disabled="@(string.IsNullOrWhiteSpace(userResponse))">
                    ↩ Send Response
                </button>
            </div>
        </div>
    }
    @if (latestBrowserScreenshot is not null || browserActions.Count > 0)
    {
        <div class="card shadow-sm mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="fw-semibold">Computer Agent Live View</span>
                <span class="badge bg-info text-dark">MVP</span>
            </div>
            <div class="card-body browser-live-view">
                <div class="browser-screenshot-pane">
                    @if (latestBrowserScreenshot is not null)
                    {
                        <img class="browser-screenshot" src="@latestBrowserScreenshot" alt="Computer agent screenshot" />
                        <small class="text-muted d-block mt-1">Latest captured screenshot from Computer_DescribeImage.</small>
                    }
                    else
                    {
                        <div class="text-muted fst-italic">No screenshot captured yet.</div>
                    }
                </div>
                <div class="browser-action-pane">
                    <div class="fw-semibold mb-1">Recent browser actions</div>
                    @if (browserActions.Count == 0)
                    {
                        <div class="text-muted fst-italic">Waiting for computer-agent actions...</div>
                    }
                    else
                    {
                        <ul class="browser-action-list">
                            @foreach (var action in browserActions)
                            {
                                <li>@action</li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>
    }
    <div class="card shadow-sm mb-3">
        <div class="card-header fw-semibold">Live activity log</div>
        <div class="card-body py-2">
            @if (activityLog.Count == 0)
            {
                <div class="text-muted small">No activity yet.</div>
            }
            else
            {
                <ul class="activity-log-list mb-0">
                    @foreach (var line in activityLog)
                    {
                        <li>@line</li>
                    }
                </ul>
            }
        </div>
    </div>
    @if (cachedMessages.Count > 0 || Session.Status is AgentTaskStatus.Running or AgentTaskStatus.WaitingForInput)
    {
        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="fw-semibold">Agent Messages</span>
                <span class="badge bg-secondary">@cachedMessages.Count</span>
            </div>
            <div class="card-body p-2 message-feed" @ref="messageFeedRef">
                @if (cachedMessages.Count == 0 && Session.Status is AgentTaskStatus.Running or AgentTaskStatus.WaitingForInput)
                {
                    <div class="message-row msg-default">
                        <span class="text-muted fst-italic">No agent messages yet. The orchestrator is preparing the run.</span>
                    </div>
                }
                @foreach (var msg in cachedMessages)
                {
                    <div class="message-row @GetMessageClass(msg.AgentName)">
                        <div class="message-header">
                            <span>@GetAgentIcon(msg.AgentName)</span>
                            <strong>@msg.AgentName</strong>
                            @if (msg.Round > 0)
                            {
                                <span class="badge bg-secondary ms-1">Round @msg.Round</span>
                            }
                            <span class="badge bg-light text-dark border ms-1">@msg.Role</span>
                            <small class="text-muted ms-auto">@msg.Timestamp.LocalDateTime.ToString("HH:mm:ss")</small>
                        </div>
                        @if (msg.Role == "browser_screenshot")
                        {
                            <p class="message-body mb-0 text-muted">Screenshot captured (see "Computer Agent Live View").</p>
                        }
                        else if (msg.Text.Contains('\n') || msg.Role is "tool" or "code_output")
                        {
                            <pre class="message-body">@msg.Text</pre>
                        }
                        else
                        {
                            <p class="message-body mb-0">@msg.Text</p>
                        }
                    </div>
                }
                @if (Session.Status == AgentTaskStatus.Running)
                {
                    <div class="message-row msg-default thinking-row">
                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        <span class="text-muted fst-italic">Agents are working…</span>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private string taskInput = string.Empty;
    private string userResponse = string.Empty;
    private string? currentTaskPrompt;
    private DateTimeOffset? currentTaskStartedAt;
    private string? copiedScenarioTitle;
    private IReadOnlyList<AgentMessage> cachedMessages = [];
    private IReadOnlyList<ModelStatusSnapshot> modelStatuses = [];
    private string? latestBrowserScreenshot;
    private IReadOnlyList<string> browserActions = [];
    private readonly List<string> activityLog = [];
    private AgentTaskStatus? previousStatus;
    private ElementReference messageFeedRef;
    private static readonly TimeSpan DownloadNoticeWindow = TimeSpan.FromSeconds(20);

    private sealed record QuickScenario(string Title, string Prompt, string TutorialUrl);

    private static readonly IReadOnlyList<QuickScenario> QuickScenarios =
    [
        new(
            "Scenario 1: Summarise a web page",
            """
            Please fetch the page at https://elbruno.com and give me a 3-sentence summary of
            what it is about.
            """,
            "https://github.com/elbruno/ElBruno.MagenticUI/blob/master/docs/tutorial.md#scenario-1--summarise-a-web-page"),
        new(
            "Scenario 2: Analyse files in the sandbox",
            """
            List all .txt files in the working directory, read them, and tell me:
            - Total amount across all invoices
            - Which client has the highest total, and what that client total is
            """,
            "https://github.com/elbruno/ElBruno.MagenticUI/blob/master/docs/tutorial.md#scenario-2--analyse-files-in-a-sandbox-directory"),
        new(
            "Scenario 3: Analyse an image with Fara computer-use",
            """
            Use Coder_ExecuteCode to download https://raw.githubusercontent.com/elbruno/ElBruno.MagenticUI/master/images/magentic_releases.png into the working directory as magentic_releases.png.
            Then call Computer_DescribeImage with:
            - relativePath: magentic_releases.png
            - prompt: "Summarize what this image shows in 3 bullets and mention any timeline insight."
            Return only the final answer.
            """,
            "https://github.com/elbruno/ElBruno.MagenticUI/blob/master/docs/tutorial.md#scenario-3--analyse-an-image-with-fara-computer-use")
    ];

    private const string TaskPlaceholder =
        "Describe what you want the agents to do…\n\nExample: Fetch the latest .NET release notes from the web and summarise them.";

    private bool IsAutoDownloadMode =>
        string.IsNullOrWhiteSpace(Config["LocalLLMs:Models:Orchestrator:ModelPath"])
        && string.IsNullOrWhiteSpace(Config["LocalLLMs:ModelPath"])
        && string.IsNullOrWhiteSpace(Config["LocalLLMs:Models:ComputerUse:ModelPath"])
        && string.IsNullOrWhiteSpace(Config["LocalLLMs:ComputerModelPath"]);

    private string OrchestratorModelName =>
        Config["LocalLLMs:Models:Orchestrator:ModelName"]
        ?? Config["LocalLLMs:ModelName"]
        ?? "magentic-brain";

    private string ComputerModelName =>
        Config["LocalLLMs:Models:ComputerUse:ModelName"]
        ?? Config["LocalLLMs:ComputerModelName"]
        ?? "fara1.5-9b";

    private IReadOnlyList<ModelStatusSnapshot> DisplayModelStatuses =>
        modelStatuses
            .OrderBy(status => status.Entry.Role)
            .ToArray();

    private IReadOnlyList<ModelStatusSnapshot> RecentDownloadNotices =>
        modelStatuses
            .Where(status =>
                status.DownloadState.Phase is ModelDownloadPhase.Completed or ModelDownloadPhase.Failed
                && DateTimeOffset.UtcNow - status.DownloadState.LastUpdated <= DownloadNoticeWindow)
            .OrderByDescending(status => status.DownloadState.LastUpdated)
            .ToArray();

    protected override void OnInitialized()
    {
        Session.OnChanged += OnSessionChanged;
        ModelDownloadProgressState.OnChanged += OnModelDownloadChanged;
        cachedMessages = Session.Messages;
        previousStatus = Session.Status;
        RefreshModelStatuses();
        RefreshBrowserState();
    }

    private string StatusText => Session.Status switch
    {
        AgentTaskStatus.Idle           => "Idle",
        AgentTaskStatus.Running        => "Running…",
        AgentTaskStatus.WaitingForInput => "Waiting for input",
        AgentTaskStatus.Done           => "Done ✓",
        AgentTaskStatus.Error          => "Error",
        _                              => "Unknown"
    };

    private string StatusBadgeClass => Session.Status switch
    {
        AgentTaskStatus.Running        => "bg-primary status-running",
        AgentTaskStatus.WaitingForInput => "bg-warning text-dark",
        AgentTaskStatus.Done           => "bg-success",
        AgentTaskStatus.Error          => "bg-danger",
        _                              => "bg-secondary"
    };

    private async Task StartTask()
    {
        if (!string.IsNullOrWhiteSpace(taskInput))
        {
            currentTaskPrompt = taskInput.Trim();
            currentTaskStartedAt = DateTimeOffset.UtcNow;
            AppendActivity($"Task started: {currentTaskPrompt}");
            await Session.StartTaskAsync(taskInput.Trim());
        }
    }

    private void UseQuickScenario(string prompt)
    {
        taskInput = prompt;
    }

    private async Task CopyQuickScenarioPrompt(QuickScenario scenario)
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", scenario.Prompt);
        copiedScenarioTitle = scenario.Title;
        await InvokeAsync(StateHasChanged);
    }

    private async Task SendResponse()
    {
        if (!string.IsNullOrWhiteSpace(userResponse))
        {
            AppendActivity($"User response sent: {userResponse.Trim()}");
            await Session.RespondToInputAsync(userResponse.Trim());
            userResponse = string.Empty;
        }
    }

    private async Task HandleTaskKeyDown(KeyboardEventArgs e)
    {
        if (e is { Key: "Enter", CtrlKey: true })
            await StartTask();
    }

    private async Task HandleResponseKeyDown(KeyboardEventArgs e)
    {
        if (e is { Key: "Enter", CtrlKey: true })
            await SendResponse();
    }

    private async Task OnSessionChanged()
    {
        if (previousStatus != Session.Status)
        {
            AppendActivity($"Status changed: {previousStatus?.ToString() ?? "Unknown"} → {Session.Status}");
            previousStatus = Session.Status;
        }

        var previousCount = cachedMessages.Count;
        cachedMessages = Session.Messages;
        if (cachedMessages.Count > previousCount)
        {
            foreach (var newMessage in cachedMessages.Skip(previousCount))
                AppendActivity($"{newMessage.AgentName}/{newMessage.Role}: {Summarize(newMessage.Text)}");
        }
        RefreshBrowserState();
        await InvokeAsync(StateHasChanged);
    }

    private void RefreshBrowserState()
    {
        latestBrowserScreenshot = cachedMessages
            .Where(msg => msg.Role == "browser_screenshot")
            .Select(msg => msg.Text)
            .LastOrDefault();

        browserActions = cachedMessages
            .Where(msg => msg.Role == "browser_action")
            .Select(msg => $"[{msg.Timestamp.LocalDateTime:HH:mm:ss}] {msg.Text}")
            .TakeLast(12)
            .ToList();
    }

    private static string GetAgentIcon(string agentName) => agentName switch
    {
        "Orchestrator" => "🎯",
        "FileSurfer"   => "📁",
        "WebFetcher"   => "🌐",
        "Coder"        => "💻",
        "Computer"     => "🖱️",
        "UserProxy"    => "👤",
        _              => "🤖"
    };

    private static string GetMessageClass(string agentName) => agentName switch
    {
        "Orchestrator" => "msg-orchestrator",
        "FileSurfer"   => "msg-filesurfer",
        "WebFetcher"   => "msg-webfetcher",
        "Coder"        => "msg-coder",
        "Computer"     => "msg-coder",
        "UserProxy"    => "msg-userproxy",
        _              => "msg-default"
    };

    private static string GetRoleLabel(ModelRole role) => role switch
    {
        ModelRole.Orchestrator => "Orchestrator",
        ModelRole.ComputerUse => "Computer",
        _ => role.ToString()
    };

    private static string GetModelLabel(ModelStatusSnapshot status)
        => status.Entry.IsPresent
            ? status.Entry.ModelId
            : "Not downloaded yet";

    private static string GetDownloadPhaseText(ModelDownloadPhase phase)
        => phase switch
        {
            ModelDownloadPhase.Downloading => "Downloading",
            ModelDownloadPhase.Completed => "Completed",
            ModelDownloadPhase.Failed => "Failed",
            _ => "Idle"
        };

    private static string GetDownloadPhaseBadgeClass(ModelDownloadPhase phase)
        => phase switch
        {
            ModelDownloadPhase.Downloading => "text-bg-primary",
            ModelDownloadPhase.Completed => "text-bg-success",
            ModelDownloadPhase.Failed => "text-bg-danger",
            _ => "text-bg-secondary"
        };

    private static string FormatBytes(long bytes)
    {
        var value = Math.Max(0, bytes);
        string[] units = ["B", "KB", "MB", "GB", "TB"];
        var unitIndex = 0;
        double size = value;

        while (size >= 1024d && unitIndex < units.Length - 1)
        {
            size /= 1024d;
            unitIndex++;
        }

        return $"{size:0.##} {units[unitIndex]}";
    }

    private async Task OnModelDownloadChanged()
    {
        RefreshModelStatuses();
        foreach (var status in modelStatuses.Where(status => status.EffectivePhase == ModelDownloadPhase.Downloading))
            AppendActivity($"{status.Entry.RoleDisplayName} model downloading: {status.DisplayPercent:0.##}%");
        await InvokeAsync(StateHasChanged);
    }

    private void RefreshModelStatuses()
        => modelStatuses = ModelStatus.GetStatuses();

    private void CancelTaskFromUi()
    {
        AppendActivity("Task cancellation requested.");
        Session.CancelTask();
    }

    private void AppendActivity(string text)
    {
        activityLog.Insert(0, $"[{DateTimeOffset.Now:HH:mm:ss}] {text}");
        if (activityLog.Count > 40)
            activityLog.RemoveAt(activityLog.Count - 1);
    }

    private static string Summarize(string text)
    {
        if (string.IsNullOrWhiteSpace(text))
            return "(empty)";

        var compact = text.Replace('\r', ' ').Replace('\n', ' ').Trim();
        return compact.Length <= 120 ? compact : $"{compact[..120]}...";
    }

    public ValueTask DisposeAsync()
    {
        Session.OnChanged -= OnSessionChanged;
        ModelDownloadProgressState.OnChanged -= OnModelDownloadChanged;
        return ValueTask.CompletedTask;
    }
}
