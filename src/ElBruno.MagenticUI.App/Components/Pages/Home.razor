@page "/"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject AgentSessionService Session
@inject IConfiguration Config
@inject IJSRuntime JS

<PageTitle>MagenticUI — Local Multi-Agent AI</PageTitle>

<div class="container-fluid py-3 magentic-root">
    <div class="row mb-3 align-items-center">
        <div class="col">
            <h2 class="mb-0 fw-bold">🧠 MagenticUI</h2>
            <small class="text-muted">Local multi-agent AI · powered by ONNX via ElBruno.LocalLLMs</small>
        </div>
        <div class="col-auto">
            <span class="badge fs-6 @StatusBadgeClass">@StatusText</span>
        </div>
    </div>
    @if (IsAutoDownloadMode)
    {
        <div class="alert alert-info d-flex align-items-start gap-2">
            <span>⚙️</span>
            <div>
                <strong>Auto-download mode enabled.</strong>
                No <code>LocalLLMs:ModelPath</code> is set, so the app will download
                <code>@ConfiguredModelName</code> on first task run.<br />
                For the agent-tuned model, convert <code>microsoft/MagenticBrain</code> to ONNX and set
                <code>LocalLLMs:ModelPath</code> to that folder.
            </div>
        </div>
    }
    @if (Session.Status is AgentTaskStatus.Error && Session.LastError is not null)
    {
        <div class="alert alert-danger">
            <strong>⚠️ Error:</strong> @Session.LastError
        </div>
    }
    @if (Session.Status is AgentTaskStatus.Idle or AgentTaskStatus.Done or AgentTaskStatus.Error)
    {
        <div class="card mb-3 shadow-sm">
            <div class="card-body">
                <h5 class="card-title mb-3">New Task</h5>
                <textarea class="form-control mb-2 task-input"
                          rows="4"
                          @bind="taskInput"
                          @bind:event="oninput"
                          placeholder="@TaskPlaceholder"
                          @onkeydown="HandleTaskKeyDown"></textarea>
                <div class="d-flex gap-2 align-items-center">
                    <button class="btn btn-primary" @onclick="StartTask"
                            disabled="@(string.IsNullOrWhiteSpace(taskInput))">
                        ▶ Start Task
                    </button>
                    <small class="text-muted">Ctrl+Enter to submit</small>
                </div>
                <div class="quick-actions mt-3">
                    <small class="text-muted d-block mb-2">Quick scenarios</small>
                    @foreach (var scenario in QuickScenarios)
                    {
                        <div class="quick-action-item">
                            <div class="quick-action-title">@scenario.Title</div>
                            <div class="quick-action-buttons">
                                <button class="btn btn-outline-primary btn-sm" @onclick="() => UseQuickScenario(scenario.Prompt)">
                                    Use prompt
                                </button>
                                <button class="btn btn-outline-success btn-sm" @onclick="() => CopyQuickScenarioPrompt(scenario)">
                                    @(copiedScenarioTitle == scenario.Title ? "Copied ✓" : "Copy prompt")
                                </button>
                                <a class="btn btn-outline-secondary btn-sm"
                                   href="@scenario.TutorialUrl"
                                   target="_blank"
                                   rel="noopener noreferrer">
                                    Tutorial
                                </a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
    @if (Session.Status is AgentTaskStatus.Running or AgentTaskStatus.WaitingForInput)
    {
        <div class="mb-3">
            <button class="btn btn-outline-danger btn-sm" @onclick="Session.CancelTask">
                ✕ Cancel Task
            </button>
        </div>
    }
    @if (Session.Status == AgentTaskStatus.WaitingForInput && Session.PendingQuestion is not null)
    {
        <div class="card border-warning mb-3 shadow-sm input-request-card">
            <div class="card-header bg-warning bg-opacity-25 fw-bold">
                👤 Agent needs your input
            </div>
            <div class="card-body">
                <p class="mb-3 fw-semibold">@Session.PendingQuestion</p>
                <textarea class="form-control mb-2"
                          rows="3"
                          @bind="userResponse"
                          @bind:event="oninput"
                          placeholder="Type your response…"
                          @onkeydown="HandleResponseKeyDown"
                          autofocus></textarea>
                <button class="btn btn-warning" @onclick="SendResponse"
                        disabled="@(string.IsNullOrWhiteSpace(userResponse))">
                    ↩ Send Response
                </button>
            </div>
        </div>
    }
    @if (cachedMessages.Count > 0)
    {
        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="fw-semibold">Agent Messages</span>
                <span class="badge bg-secondary">@cachedMessages.Count</span>
            </div>
            <div class="card-body p-2 message-feed" @ref="messageFeedRef">
                @foreach (var msg in cachedMessages)
                {
                    <div class="message-row @GetMessageClass(msg.AgentName)">
                        <div class="message-header">
                            <span>@GetAgentIcon(msg.AgentName)</span>
                            <strong>@msg.AgentName</strong>
                            @if (msg.Round > 0)
                            {
                                <span class="badge bg-secondary ms-1">Round @msg.Round</span>
                            }
                            <span class="badge bg-light text-dark border ms-1">@msg.Role</span>
                            <small class="text-muted ms-auto">@msg.Timestamp.LocalDateTime.ToString("HH:mm:ss")</small>
                        </div>
                        @if (msg.Text.Contains('\n') || msg.Role is "tool" or "code_output")
                        {
                            <pre class="message-body">@msg.Text</pre>
                        }
                        else
                        {
                            <p class="message-body mb-0">@msg.Text</p>
                        }
                    </div>
                }
                @if (Session.Status == AgentTaskStatus.Running)
                {
                    <div class="message-row msg-default thinking-row">
                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        <span class="text-muted fst-italic">Agents are working…</span>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private string taskInput = string.Empty;
    private string userResponse = string.Empty;
    private string? copiedScenarioTitle;
    private IReadOnlyList<AgentMessage> cachedMessages = [];
    private ElementReference messageFeedRef;

    private sealed record QuickScenario(string Title, string Prompt, string TutorialUrl);

    private static readonly IReadOnlyList<QuickScenario> QuickScenarios =
    [
        new(
            "Scenario 1: Summarise a web page",
            """
            Please fetch the page at https://elbruno.com and give me a 3-sentence summary of
            what it is about.
            """,
            "https://github.com/elbruno/ElBruno.MagenticUI/blob/master/docs/tutorial.md#scenario-1--summarise-a-web-page"),
        new(
            "Scenario 2: Analyse files in the sandbox",
            """
            List all .txt files in the working directory, read them, and tell me:
            - Total amount across all invoices
            - Which client has the highest total, and what that client total is
            """,
            "https://github.com/elbruno/ElBruno.MagenticUI/blob/master/docs/tutorial.md#scenario-2--analyse-files-in-a-sandbox-directory"),
        new(
            "Scenario 3: Analyse an image with Python",
            """
            Use Coder_ExecuteCode to download https://raw.githubusercontent.com/elbruno/ElBruno.MagenticUI/master/images/magentic_releases.png into the working directory as magentic_releases.png.
            Then read the PNG header in Python (standard library only) and report:
            - width
            - height
            - file size in KB
            Finally explain in 2 sentences what this image illustrates.
            """,
            "https://github.com/elbruno/ElBruno.MagenticUI/blob/master/docs/tutorial.md#scenario-3--analyse-an-image-in-the-sandbox")
    ];

    private const string TaskPlaceholder =
        "Describe what you want the agents to do…\n\nExample: Fetch the latest .NET release notes from the web and summarise them.";

    private bool IsAutoDownloadMode =>
        string.IsNullOrWhiteSpace(Config["LocalLLMs:ModelPath"]);

    private string ConfiguredModelName =>
        Config["LocalLLMs:ModelName"] ?? "magentic-brain";

    protected override void OnInitialized()
    {
        Session.OnChanged += OnSessionChanged;
        cachedMessages = Session.Messages;
    }

    private string StatusText => Session.Status switch
    {
        AgentTaskStatus.Idle           => "Idle",
        AgentTaskStatus.Running        => "Running…",
        AgentTaskStatus.WaitingForInput => "Waiting for input",
        AgentTaskStatus.Done           => "Done ✓",
        AgentTaskStatus.Error          => "Error",
        _                              => "Unknown"
    };

    private string StatusBadgeClass => Session.Status switch
    {
        AgentTaskStatus.Running        => "bg-primary",
        AgentTaskStatus.WaitingForInput => "bg-warning text-dark",
        AgentTaskStatus.Done           => "bg-success",
        AgentTaskStatus.Error          => "bg-danger",
        _                              => "bg-secondary"
    };

    private async Task StartTask()
    {
        if (!string.IsNullOrWhiteSpace(taskInput))
            await Session.StartTaskAsync(taskInput.Trim());
    }

    private void UseQuickScenario(string prompt)
    {
        taskInput = prompt;
    }

    private async Task CopyQuickScenarioPrompt(QuickScenario scenario)
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", scenario.Prompt);
        copiedScenarioTitle = scenario.Title;
        await InvokeAsync(StateHasChanged);
    }

    private async Task SendResponse()
    {
        if (!string.IsNullOrWhiteSpace(userResponse))
        {
            await Session.RespondToInputAsync(userResponse.Trim());
            userResponse = string.Empty;
        }
    }

    private async Task HandleTaskKeyDown(KeyboardEventArgs e)
    {
        if (e is { Key: "Enter", CtrlKey: true })
            await StartTask();
    }

    private async Task HandleResponseKeyDown(KeyboardEventArgs e)
    {
        if (e is { Key: "Enter", CtrlKey: true })
            await SendResponse();
    }

    private async Task OnSessionChanged()
    {
        cachedMessages = Session.Messages;
        await InvokeAsync(StateHasChanged);
    }

    private static string GetAgentIcon(string agentName) => agentName switch
    {
        "Orchestrator" => "🎯",
        "FileSurfer"   => "📁",
        "WebFetcher"   => "🌐",
        "Coder"        => "💻",
        "UserProxy"    => "👤",
        _              => "🤖"
    };

    private static string GetMessageClass(string agentName) => agentName switch
    {
        "Orchestrator" => "msg-orchestrator",
        "FileSurfer"   => "msg-filesurfer",
        "WebFetcher"   => "msg-webfetcher",
        "Coder"        => "msg-coder",
        "UserProxy"    => "msg-userproxy",
        _              => "msg-default"
    };

    public ValueTask DisposeAsync()
    {
        Session.OnChanged -= OnSessionChanged;
        return ValueTask.CompletedTask;
    }
}
