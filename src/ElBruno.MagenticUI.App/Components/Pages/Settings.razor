@page "/settings"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject IModelSettingsService ModelSettings
@inject IModelStatusService ModelStatus
@inject IModelDownloadProgressStateService ModelDownloadProgressState
@inject IAppRuntimeSettingsService RuntimeSettings
@using ElBruno.MagenticUI.App.ModelDownloadProgress
@using ElBruno.MagenticUI.App.Configuration
@using ElBruno.MagenticUI.App.ModelSettings

<PageTitle>Settings — Model Management</PageTitle>

<div class="container-fluid py-3 settings-root">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
        <div>
            <h2 class="mb-1 fw-bold">⚙️ Settings</h2>
            <p class="text-muted mb-0">Model paths, local presence, and download progress.</p>
        </div>
        <span class="badge text-bg-light border px-3 py-2">Models: @modelStatuses.Count</span>
    </div>

    <div class="card shadow-sm mb-3">
        <div class="card-header fw-semibold">Runtime configuration</div>
        <div class="card-body">
            @if (!string.IsNullOrWhiteSpace(runtimeMessage))
            {
                <div class="alert @runtimeMessageClass d-flex justify-content-between align-items-start gap-2 py-2">
                    <span>@runtimeMessage</span>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="ClearRuntimeMessage"></button>
                </div>
            }

            <div class="row g-3">
                <div class="col-12 col-xl-6">
                    <label class="form-label fw-semibold" for="orchestratorModelPath">Orchestrator model path</label>
                    <input id="orchestratorModelPath" class="form-control" @bind="orchestratorModelPath" />
                    <div class="form-text">Leave blank to use auto-download for the orchestrator model.</div>
                </div>

                <div class="col-12 col-xl-6">
                    <label class="form-label fw-semibold" for="computerUseModelPath">Computer-use model path</label>
                    <input id="computerUseModelPath" class="form-control" @bind="computerUseModelPath" />
                    <div class="form-text">Leave blank to use auto-download for the computer-use model.</div>
                </div>

                <div class="col-12 col-md-6 col-xl-3">
                    <label class="form-label fw-semibold" for="maxRounds">Max rounds</label>
                    <input id="maxRounds" class="form-control" type="number" min="1" step="1" @bind="maxRounds" />
                </div>

                <div class="col-12 col-md-6 col-xl-3">
                    <label class="form-label fw-semibold" for="taskTimeoutSeconds">Task timeout (seconds)</label>
                    <input id="taskTimeoutSeconds" class="form-control" type="number" min="0" step="1" @bind="taskTimeoutSeconds" />
                    <div class="form-text">Set to 0 to disable the overall task timeout.</div>
                </div>

                <div class="col-12 col-md-6 col-xl-3">
                    <label class="form-label fw-semibold" for="maxOutputTokens">Max output tokens</label>
                    <input id="maxOutputTokens" class="form-control" type="number" min="1" step="1" @bind="maxOutputTokens" />
                    <div class="form-text">Limits each orchestrator model response to keep local runs responsive. Lower = faster/shorter, higher = slower/more complete.</div>
                </div>
            </div>

            <div class="d-flex gap-2 flex-wrap mt-3">
                <button class="btn btn-primary"
                        disabled="@isSavingRuntimeSettings"
                        @onclick="SaveRuntimeSettingsAsync">
                    @(isSavingRuntimeSettings ? "Saving..." : "Save settings")
                </button>
                <button class="btn btn-outline-secondary"
                        disabled="@isSavingRuntimeSettings"
                        @onclick="ReloadRuntimeSettingsAsync">
                    Reload current values
                </button>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(actionMessage))
    {
        <div class="alert @actionMessageClass d-flex justify-content-between align-items-start gap-2 py-2">
            <span>@actionMessage</span>
            <button type="button" class="btn-close" aria-label="Close" @onclick="ClearActionMessage"></button>
        </div>
    }

    @if (isLoading)
    {
        <div class="card shadow-sm">
            <div class="card-body d-flex align-items-center gap-2">
                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                <span>Loading model settings…</span>
            </div>
        </div>
    }
    else if (modelStatuses.Count == 0)
    {
        <div class="alert alert-secondary">No model entries were found in the current configuration.</div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var modelStatus in modelStatuses)
            {
                var entry = modelStatus.Entry;
                var downloadState = modelStatus.DownloadState;
                var effectiveDownloadPhase = modelStatus.EffectivePhase;
                <div class="col-12 col-xl-6">
                    <article class="card shadow-sm h-100 settings-model-card">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start gap-2 flex-wrap mb-2">
                                <div>
                                    <div class="text-muted small">Role</div>
                                    <h5 class="mb-0">@entry.RoleDisplayName</h5>
                                </div>
                                <div class="d-flex flex-wrap gap-1 justify-content-end">
                                    <span class="badge @(entry.IsPresent ? "text-bg-success" : "text-bg-warning text-dark")">
                                        @(entry.IsPresent ? "Present" : "Missing")
                                    </span>
                                    <span class="badge @GetDownloadBadgeClass(effectiveDownloadPhase)">
                                        @GetDownloadPhaseText(effectiveDownloadPhase)
                                    </span>
                                </div>
                            </div>

                            <div class="small mb-2">
                                <div><strong>Model:</strong> @entry.ModelName</div>
                                <div class="text-muted"><code>@entry.ModelId</code></div>
                            </div>

                            <div class="small mb-2">
                                <div class="fw-semibold">Effective model path</div>
                                <code class="settings-model-path">@entry.EffectiveModelPath</code>
                            </div>

                            <div class="small text-muted mb-2">
                                @entry.StatusText
                            </div>

                            <div class="small mb-3">
                                <div class="fw-semibold">Download status</div>
                                <div>@modelStatus.StatusText</div>
                                @if (effectiveDownloadPhase == ModelDownloadPhase.Downloading)
                                {
                                    <div class="progress settings-download-progress mt-1" role="progressbar" aria-valuenow="@modelStatus.DisplayPercent" aria-valuemin="0" aria-valuemax="100">
                                        <div class="progress-bar progress-bar-striped progress-bar-animated"
                                             style="width: @($"{modelStatus.DisplayPercent:0.##}%")"></div>
                                    </div>
                                    @if (downloadState.TotalBytes > 0)
                                    {
                                        <div class="small text-muted mt-1">
                                            @FormatBytes(downloadState.DownloadedBytes) / @FormatBytes(downloadState.TotalBytes)
                                        </div>
                                    }
                                }
                                @if (!string.IsNullOrWhiteSpace(downloadState.Error))
                                {
                                    <div class="text-danger small mt-1">Error: @downloadState.Error</div>
                                }
                            </div>

                            <div class="d-flex gap-2 flex-wrap">
                                @if (modelStatus.CanDownload)
                                {
                                    <button class="btn btn-primary btn-sm"
                                            disabled="@(pendingDownload.Contains(entry.Role))"
                                            @onclick="() => DownloadModelAsync(entry)">
                                        @(pendingDownload.Contains(entry.Role) ? "Downloading..." : "Download model")
                                    </button>
                                }
                                else if (entry.IsPresent)
                                {
                                    <button class="btn btn-success btn-sm" disabled>
                                        Model downloaded
                                    </button>
                                }
                                else
                                {
                                    <button class="btn btn-secondary btn-sm" disabled title="Download is unavailable when an explicit ModelPath is configured.">
                                        Download unavailable
                                    </button>
                                }
                                <button class="btn btn-outline-secondary btn-sm" @onclick="() => OpenModelFolderAsync(entry)">
                                    Open folder
                                </button>
                                @if (pendingDeleteConfirmation.Contains(entry.Role))
                                {
                                    <button class="btn btn-danger btn-sm" @onclick="() => ConfirmDeleteModelAsync(entry.Role)">
                                        Confirm delete
                                    </button>
                                    <button class="btn btn-outline-secondary btn-sm" @onclick="() => CancelDelete(entry.Role)">
                                        Cancel
                                    </button>
                                }
                                else
                                {
                                    <button class="btn btn-outline-danger btn-sm"
                                            disabled="@(effectiveDownloadPhase == ModelDownloadPhase.Downloading)"
                                            @onclick="() => RequestDelete(entry.Role)">
                                        Delete model
                                    </button>
                                }
                            </div>
                            @if (pendingDeleteConfirmation.Contains(entry.Role))
                            {
                                <div class="alert alert-warning mt-3 mb-0 py-2">
                                    Delete all files for <strong>@entry.RoleDisplayName</strong> from
                                    <code>@entry.EffectiveModelPath</code>?
                                    This cannot be undone.
                                </div>
                            }
                        </div>
                    </article>
                </div>
            }
        </div>
    }
</div>

@code {
    private readonly HashSet<ModelRole> pendingDeleteConfirmation = [];
    private readonly HashSet<ModelRole> pendingDownload = [];
    private IReadOnlyList<ModelStatusSnapshot> modelStatuses = [];
    private bool isLoading = true;
    private string? actionMessage;
    private string actionMessageClass = "alert-info";
    private string? runtimeMessage;
    private string runtimeMessageClass = "alert-info";
    private string orchestratorModelPath = string.Empty;
    private string computerUseModelPath = string.Empty;
    private int maxRounds = 15;
    private int taskTimeoutSeconds;
    private int maxOutputTokens = 256;
    private bool isSavingRuntimeSettings;

    protected override async Task OnInitializedAsync()
    {
        ModelDownloadProgressState.OnChanged += OnDownloadStateChangedAsync;
        await ReloadRuntimeSettingsAsync();
        await RefreshModelDataAsync();
        isLoading = false;
    }

    private async Task OnDownloadStateChangedAsync()
    {
        RefreshModelStatuses();
        await InvokeAsync(StateHasChanged);
    }

    private async Task OpenModelFolderAsync(ModelSettingsEntry entry)
    {
        var result = ModelSettings.OpenModelFolder(entry.Role);
        SetActionMessage(result);
        await InvokeAsync(StateHasChanged);
    }

    private Task DownloadModelAsync(ModelSettingsEntry entry)
    {
        if (!CanDownload(entry.Role) || pendingDownload.Contains(entry.Role))
            return Task.CompletedTask;

        pendingDeleteConfirmation.Remove(entry.Role);
        pendingDownload.Add(entry.Role);
        actionMessageClass = "alert-info";
        actionMessage = $"Starting download for {entry.RoleDisplayName}...";
        _ = InvokeAsync(StateHasChanged);

        _ = Task.Run(async () =>
        {
            ModelFileOperationResult result;
            try
            {
                result = await ModelSettings.DownloadModelAsync(entry.Role);
            }
            catch (Exception ex)
            {
                result = new ModelFileOperationResult(false, $"Failed to download model for {entry.RoleDisplayName}: {ex.Message}");
            }

            pendingDownload.Remove(entry.Role);
            await RefreshModelDataAsync();
            SetActionMessage(result);
            await InvokeAsync(StateHasChanged);
        });

        return Task.CompletedTask;
    }

    private void ClearActionMessage()
        => actionMessage = null;

    private void ClearRuntimeMessage()
        => runtimeMessage = null;

    private void RequestDelete(ModelRole role)
    {
        pendingDeleteConfirmation.Clear();
        pendingDeleteConfirmation.Add(role);
        actionMessageClass = "alert-warning";
        actionMessage = "Please confirm model deletion.";
    }

    private void CancelDelete(ModelRole role)
    {
        pendingDeleteConfirmation.Remove(role);
        actionMessageClass = "alert-secondary";
        actionMessage = "Delete cancelled.";
    }

    private async Task ConfirmDeleteModelAsync(ModelRole role)
    {
        var result = ModelSettings.DeleteModelFiles(role, isConfirmed: true);
        pendingDeleteConfirmation.Remove(role);
        await RefreshModelDataAsync();
        SetActionMessage(result);
        await InvokeAsync(StateHasChanged);
    }

    private Task RefreshModelDataAsync()
    {
        RefreshModelStatuses();
        return Task.CompletedTask;
    }

    private Task ReloadRuntimeSettingsAsync()
    {
        var settings = RuntimeSettings.GetCurrentSettings();
        orchestratorModelPath = settings.OrchestratorModelPath;
        computerUseModelPath = settings.ComputerUseModelPath;
        maxRounds = settings.MaxRounds;
        taskTimeoutSeconds = settings.TaskTimeoutSeconds;
        maxOutputTokens = settings.MaxOutputTokens;
        return Task.CompletedTask;
    }

    private async Task SaveRuntimeSettingsAsync()
    {
        if (isSavingRuntimeSettings)
            return;

        isSavingRuntimeSettings = true;
        runtimeMessage = "Saving runtime settings...";
        runtimeMessageClass = "alert-info";
        await InvokeAsync(StateHasChanged);

        var result = await RuntimeSettings.SaveAsync(new RuntimeSettingsSnapshot(
            orchestratorModelPath,
            computerUseModelPath,
            maxRounds,
            taskTimeoutSeconds,
            maxOutputTokens));

        runtimeMessageClass = result.Succeeded ? "alert-success" : "alert-danger";
        runtimeMessage = result.Message;
        isSavingRuntimeSettings = false;

        if (result.Succeeded)
            await RefreshModelDataAsync();

        await InvokeAsync(StateHasChanged);
    }

    private void RefreshModelStatuses()
    {
        modelStatuses = ModelStatus.GetStatuses();
    }

    private bool CanDownload(ModelRole role)
        => modelStatuses.FirstOrDefault(status => status.Entry.Role == role)?.CanDownload ?? false;

    private static string GetDownloadBadgeClass(ModelDownloadPhase phase)
        => phase switch
        {
            ModelDownloadPhase.Downloading => "text-bg-primary",
            ModelDownloadPhase.Completed => "text-bg-success",
            ModelDownloadPhase.Failed => "text-bg-danger",
            _ => "text-bg-secondary"
        };

    private static string GetDownloadPhaseText(ModelDownloadPhase phase)
        => phase switch
        {
            ModelDownloadPhase.Downloading => "Downloading",
            ModelDownloadPhase.Completed => "Completed",
            ModelDownloadPhase.Failed => "Failed",
            _ => "Idle"
        };

    private static string FormatBytes(long bytes)
    {
        var value = Math.Max(0, bytes);
        string[] units = ["B", "KB", "MB", "GB", "TB"];
        var unitIndex = 0;
        double size = value;

        while (size >= 1024d && unitIndex < units.Length - 1)
        {
            size /= 1024d;
            unitIndex++;
        }

        return $"{size:0.##} {units[unitIndex]}";
    }

    private void SetActionMessage(ModelFileOperationResult result)
    {
        actionMessageClass = result.Succeeded ? "alert-success" : "alert-danger";
        actionMessage = result.Message;
    }

    public ValueTask DisposeAsync()
    {
        ModelDownloadProgressState.OnChanged -= OnDownloadStateChangedAsync;
        return ValueTask.CompletedTask;
    }
}
