<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ElBruno.LocalLLMs" Version="0.21.0" />
    <!-- GPU note: Microsoft.ML.OnnxRuntimeGenAI.Cuda 0.15.x is built against ONNX Runtime 1.28,
         whose CUDA execution provider requires the CUDA 13 runtime (cublasLt64_13.dll) and an
         NVIDIA driver >= 580, neither of which ONNX Runtime redistributes. This machine has a
         capable GPU (NVIDIA A10-24Q) but its driver (553.62 / CUDA 12.4) does not yet meet that
         bar, so ElBruno.LocalLLMs' provider preflight still degrades Auto to Cpu at runtime -
         see docs/fara-execution-providers.md for the driver/CUDA 13/cuDNN 9 upgrade steps
         required before this actually activates GPU inference. The .Cuda package is referenced
         directly (rather than the CPU package) so it takes effect as soon as the host meets the
         CUDA 13 requirements, without another code change.
         Direct reference required: OnnxRuntimeGenAI's buildTransitive/ omits win-x64, so the
         native onnxruntime-genai.dll is only copied when referenced directly. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntimeGenAI.Cuda" Version="0.15.1" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.8.3" />
    <PackageReference Include="ElBruno.LocalLLMs.BlazorComponents" Version="0.21.0" />
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="2.88.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ElBruno.MagenticUI.Agents\ElBruno.MagenticUI.Agents.csproj" />
    <ProjectReference Include="..\ElBruno.MagenticUI.ServiceDefaults\ElBruno.MagenticUI.ServiceDefaults.csproj" />
  </ItemGroup>

  <!-- onnxruntime-genai.dll is flattened to the output root, but it loads onnxruntime.dll and
       onnxruntime_providers_*.dll through the OS loader, which searches its own directory.
       Copy the win-x64 natives alongside it so the CUDA provider can be found. -->
  <Target Name="CopyOnnxWinNativesToOutputRoot" AfterTargets="Build" Condition="'$(OS)' == 'Windows_NT'">
    <ItemGroup>
      <OnnxWinNative Include="$(OutputPath)runtimes\win-x64\native\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(OnnxWinNative)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>

</Project>
