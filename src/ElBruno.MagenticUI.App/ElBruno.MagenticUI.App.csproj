<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ElBruno.LocalLLMs" Version="0.20.4" />
    <!-- Direct reference required: OnnxRuntimeGenAI's buildTransitive/ omits win-x64,
         so the native onnxruntime-genai.dll is only copied when referenced directly. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntimeGenAI" Version="0.14.1" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.8.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ElBruno.MagenticUI.Agents\ElBruno.MagenticUI.Agents.csproj" />
    <ProjectReference Include="..\ElBruno.MagenticUI.ServiceDefaults\ElBruno.MagenticUI.ServiceDefaults.csproj" />
  </ItemGroup>

</Project>
